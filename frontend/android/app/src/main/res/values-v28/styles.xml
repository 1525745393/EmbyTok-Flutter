<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9（API 28+）专属主题覆盖。

    刘海屏 / 挖孔屏适配：
    - windowLayoutInDisplayCutoutMode = shortEdges 让窗口内容延伸到刘海 /
      挖孔区域，配合 Flutter 端 SafeInsets（取 viewPadding）对交互控件做避让，
      避免横屏全屏视频出现两侧黑边或控件被刘海物理遮挡。
    - 仅在此文件（values-v28）声明该属性，values/styles.xml 不声明，
      确保运行在 API < 28 的设备上不会因未知属性导致编译或运行异常。
    - 继承 values/styles.xml 中的同名主题，仅追加 cutout 模式一项。
-->
<resources>
    <style name="LaunchTheme" parent="@style/LaunchTheme">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="NormalTheme" parent="@style/NormalTheme">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
